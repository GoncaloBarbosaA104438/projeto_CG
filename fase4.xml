<?xml version="1.0" encoding="utf-8"?>
<world>
    <window width="1000" height="1000" />

    <camera>
        <position x="60" y="80" z="180" />
        <lookAt x="0" y="0" z="0" />
        <up x="0" y="1" z="0" />
        <projection fov="60" near="1" far="2000" />
    </camera>

    <!-- Ponto de luz no centro do Sol -->
    <lights>
        <light type="point" posX="0" posY="0" posZ="0" />
    </lights>

    <group>

        <!-- Sol -->
        <group>
            <transform>
                <rotate time="60" x="0" y="1" z="0" />
                <scale x="20.0" y="20.0" z="20.0" />
            </transform>
            <models>
                <model file="sol.3d">
                    <texture file="sun.jpg" />
                    <color>
                        <diffuse  R="255" G="255" B="200" />
                        <ambient  R="255" G="255" B="200" />
                        <specular R="0"   G="0"   B="0"   />
                        <emissive R="255" G="200" B="50"  />
                        <shininess value="0" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Mercúrio -->
        <group>
            <transform>
                <translate time="8" align="True">
                    <point x="24" y="0" z="0" />
                    <point x="0"  y="0" z="24" />
                    <point x="-24" y="0" z="0" />
                    <point x="0"  y="0" z="-24" />
                </translate>
                <rotate time="2" x="0" y="1" z="0" />
                <scale x="0.3" y="0.3" z="0.3" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="mercury.jpg" />
                    <color>
                        <diffuse  R="180" G="160" B="140" />
                        <ambient  R="50"  G="45"  B="40"  />
                        <specular R="30"  G="30"  B="30"  />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="10" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Vénus -->
        <group>
            <transform>
                <translate time="12" align="True">
                    <point x="29" y="0" z="0" />
                    <point x="0"  y="0" z="29" />
                    <point x="-29" y="0" z="0" />
                    <point x="0"  y="0" z="-29" />
                </translate>
                <rotate time="3" x="0" y="1" z="0" />
                <scale x="0.5" y="0.5" z="0.5" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="venus.jpg" />
                    <color>
                        <diffuse  R="220" G="180" B="100" />
                        <ambient  R="60"  G="50"  B="30"  />
                        <specular R="40"  G="40"  B="20"  />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="15" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Terra + Lua -->
        <group>
            <transform>
                <translate time="16" align="True">
                    <point x="34" y="0" z="0" />
                    <point x="0"  y="0" z="34" />
                    <point x="-34" y="0" z="0" />
                    <point x="0"  y="0" z="-34" />
                </translate>
            </transform>
            <!-- Terra -->
            <group>
                <transform>
                    <rotate time="4" x="0" y="1" z="0" />
                    <scale x="0.5" y="0.5" z="0.5" />
                </transform>
                <models>
                    <model file="planeta.3d">
                        <texture file="earth.jpg" />
                        <color>
                            <diffuse  R="100" G="140" B="200" />
                            <ambient  R="30"  G="40"  B="60"  />
                            <specular R="80"  G="80"  B="120" />
                            <emissive R="0"   G="0"   B="0"   />
                            <shininess value="40" />
                        </color>
                    </model>
                </models>
            </group>
            <!-- Lua -->
            <group>
                <transform>
                    <translate time="2" align="True">
                        <point x="1.5" y="0" z="0" />
                        <point x="0"   y="0" z="1.5" />
                        <point x="-1.5" y="0" z="0" />
                        <point x="0"   y="0" z="-1.5" />
                    </translate>
                    <scale x="0.1" y="0.1" z="0.1" />
                </transform>
                <models>
                    <model file="lua.3d">
                        <texture file="moon.jpg" />
                        <color>
                            <diffuse  R="180" G="180" B="180" />
                            <ambient  R="50"  G="50"  B="50"  />
                            <specular R="10"  G="10"  B="10"  />
                            <emissive R="0"   G="0"   B="0"   />
                            <shininess value="5" />
                        </color>
                    </model>
                </models>
            </group>
        </group>

        <!-- Marte -->
        <group>
            <transform>
                <translate time="22" align="True">
                    <point x="39" y="0" z="0" />
                    <point x="0"  y="0" z="39" />
                    <point x="-39" y="0" z="0" />
                    <point x="0"  y="0" z="-39" />
                </translate>
                <rotate time="4.5" x="0" y="1" z="0" />
                <scale x="0.4" y="0.4" z="0.4" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="mars.jpg" />
                    <color>
                        <diffuse  R="200" G="100" B="60"  />
                        <ambient  R="60"  G="30"  B="20"  />
                        <specular R="20"  G="10"  B="5"   />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="10" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Júpiter -->
        <group>
            <transform>
                <translate time="40" align="True">
                    <point x="49" y="0" z="0" />
                    <point x="0"  y="0" z="49" />
                    <point x="-49" y="0" z="0" />
                    <point x="0"  y="0" z="-49" />
                </translate>
                <rotate time="10" x="0" y="1" z="0" />
                <scale x="6.0" y="6.0" z="6.0" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="jupiter.jpg" />
                    <color>
                        <diffuse  R="220" G="180" B="140" />
                        <ambient  R="60"  G="50"  B="40"  />
                        <specular R="30"  G="25"  B="20"  />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="20" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Saturno + Anel -->
        <group>
            <transform>
                <translate time="60" align="True">
                    <point x="66" y="0" z="0" />
                    <point x="0"  y="0" z="66" />
                    <point x="-66" y="0" z="0" />
                    <point x="0"  y="0" z="-66" />
                </translate>
            </transform>
            <group>
                <transform>
                    <rotate time="8" x="0" y="1" z="0" />
                </transform>
                <group>
                    <transform><scale x="5.0" y="5.0" z="5.0" /></transform>
                    <models>
                        <model file="planeta.3d">
                            <texture file="saturn.jpg" />
                            <color>
                                <diffuse  R="210" G="190" B="140" />
                                <ambient  R="60"  G="55"  B="40"  />
                                <specular R="40"  G="35"  B="25"  />
                                <emissive R="0"   G="0"   B="0"   />
                                <shininess value="25" />
                            </color>
                        </model>
                    </models>
                </group>
                <group>
                    <transform><scale x="3.5" y="3.5" z="3.5" /></transform>
                    <models>
                        <model file="anel.3d">
                            <texture file="saturn_ring.png" />
                            <color>
                                <diffuse  R="200" G="180" B="130" />
                                <ambient  R="60"  G="55"  B="40"  />
                                <specular R="10"  G="10"  B="8"   />
                                <emissive R="0"   G="0"   B="0"   />
                                <shininess value="5" />
                            </color>
                        </model>
                    </models>
                </group>
            </group>
        </group>

        <!-- Urano -->
        <group>
            <transform>
                <translate time="80" align="True">
                    <point x="80" y="0" z="0" />
                    <point x="0"  y="0" z="80" />
                    <point x="-80" y="0" z="0" />
                    <point x="0"  y="0" z="-80" />
                </translate>
                <rotate time="7" x="0" y="1" z="0" />
                <scale x="3.0" y="3.0" z="3.0" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="uranus.jpg" />
                    <color>
                        <diffuse  R="150" G="220" B="220" />
                        <ambient  R="45"  G="65"  B="65"  />
                        <specular R="40"  G="60"  B="60"  />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="30" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Neptuno -->
        <group>
            <transform>
                <translate time="100" align="True">
                    <point x="90" y="0" z="0" />
                    <point x="0"  y="0" z="90" />
                    <point x="-90" y="0" z="0" />
                    <point x="0"  y="0" z="-90" />
                </translate>
                <rotate time="7" x="0" y="1" z="0" />
                <scale x="3.0" y="3.0" z="3.0" />
            </transform>
            <models>
                <model file="planeta.3d">
                    <texture file="neptune.jpg" />
                    <color>
                        <diffuse  R="60"  G="100" B="200" />
                        <ambient  R="20"  G="30"  B="60"  />
                        <specular R="40"  G="60"  B="120" />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="35" />
                    </color>
                </model>
            </models>
        </group>

        <!-- Cometa (Teapot - Bezier) com trajetória Catmull-Rom -->
        <group>
            <transform>
                <translate time="25" align="True">
                    <point x="100" y="40"  z="0"  />
                    <point x="0"   y="0"   z="80" />
                    <point x="-100" y="-40" z="0"  />
                    <point x="0"   y="0"   z="-80" />
                </translate>
                <rotate angle="-90" x="0" y="1" z="0" />
                <scale x="0.8" y="0.8" z="0.8" />
            </transform>
            <models>
                <model file="teapot.3d">
                    <color>
                        <diffuse  R="200" G="200" B="255" />
                        <ambient  R="50"  G="50"  B="80"  />
                        <specular R="200" G="200" B="255" />
                        <emissive R="0"   G="0"   B="0"   />
                        <shininess value="80" />
                    </color>
                </model>
            </models>
        </group>

    </group>
</world>
